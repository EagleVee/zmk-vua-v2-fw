if SHIELD_CHUTCHIT_LEFT

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "Chutchit"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CHUTCHIT_LEFT || SHIELD_CHUTCHIT_RIGHT || SHIELD_CHUTCHIT_NUM

config ZMK_SPLIT
    default y

endif

if SHIELD_CHUTCHIT_LEFT

config ZMK_SPLIT_ESB_CENTRAL_PERIPHERALS
    default 2

endif

if SHIELD_CHUTCHIT_RIGHT

config ZMK_SPLIT_ESB_PERIPHERAL_INDEX
    default 0

endif

if SHIELD_CHUTCHIT_NUM

config ZMK_SPLIT_ESB_PERIPHERAL_INDEX
    default 1

endif

# Force-enable Mouse Emulation and HID Mouse Reports
CONFIG_ZMK_POINTING=y
CONFIG_ZMK_HID_REPORT_MOUSE=y
CONFIG_ZMK_MOUSE=y
CONFIG_ZMK_HID_REPORT_KEYBOARD=y
CONFIG_ZMK_HID_BOOT_PROTOCOL=y