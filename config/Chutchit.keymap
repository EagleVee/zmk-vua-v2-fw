#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER  1
#define RAISE  2
#define ADJUST 3
#define FUNCTION 4

/* NOTE: At the time of the creation of this keymap, there are no specified codes for 'eisuu' and 'kana' input in ZMK.
However, 'LANG1' and 'LANG2' are fully-functioning candidates for 'kana' and 'eisuu' input respectively.
As such, those are in use within the default layer at this time.*/

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { tapping-term-ms = <300>; };

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

/ {
    behaviors {
        Scroll_DU: Scroll_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_DU";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        Scroll_UD: Scroll_UD {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_UD";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Td_01: Td_01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_01";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp ASTRK>, <&kp SLASH>, <&kp PAUSE_BREAK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        BT-del-all {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <6 7>;
            layers = <1>;
        };

        lpar {
            bindings = <&kp LPAR>;
            key-positions = <31 32>;
            layers = <0>;
        };

        rpar {
            bindings = <&kp RPAR>;
            key-positions = <32 33>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3  &kp N4     &kp N5  &kp N7     &kp N8    &kp N9    &kp N0     &kp MINUS  &kp LS(PLUS)  &kp BSLH  &kp GRAVE  &kp DEL        &kp KP_NUMLOCK   &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS
&kp TAB    &kp Q     &kp W     &kp E   &kp R      &kp T   &kp Y      &kp U     &kp I     &kp O      &kp P      &kp LBKT      &kp RBKT  &kp BSPC   &kp HOME       &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_PLUS
&kp CAPS   &kp A     &kp S     &kp D   &kp F      &kp G              &kp H     &kp J     &kp K      &kp L      &kp SEMI      &kp SQT   &kp ENTER  &kp PAGE_UP    &kp KP_N4        &kp KP_N5        &kp KP_N6
&kp LSHFT  &kp Z     &kp X     &kp C   &kp V      &kp B              &kp N     &kp M     &kp COMMA  &kp DOT    &kp DOT       &kp FSLH  &kp LSHFT  &kp PAGE_DOWN  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp ENTER
&kp LCTRL  &kp LGUI  &kp LALT          &kp SPACE  &kp N6  &kp SPACE  &kp RALT  &kp LGUI  &kp RCTRL  &kp UP     &kp LEFT      &kp DOWN  &kp RIGHT  &kp RET        &kp KP_NUMBER_0                   &kp DEL
            >;

            sensor-bindings = <&Scroll_DU>, <&Scroll_DU>;
        };

        layer_1 {
            bindings = <
&out OUT_USB   &out OUT_BLE   &out OUT_2G4   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_PREVIOUS C_NEXT>,
                <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
            >;

            sensor-bindings = <&Scroll_DU>, <&Scroll_UD>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
            >;

            sensor-bindings = <&Scroll_DU>, <&Scroll_UD>;
        };
    };
};
